/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "watchtower-api",
	"main": "src/index.js",
	"compatibility_date": "2026-05-08",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Credentialed CORS allowlist (ADR-0005): origins allowed to call /api/*
	// with the session cookie. localhost:5500 covers Live Server FE dev.
	// SESSION_SECRET is a `wrangler secret`, not a var.
	"vars": {
		"ALLOWED_ORIGINS": "https://watchtower-page.pages.dev,http://localhost:5500,http://127.0.0.1:5500"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "watchtower",
			"database_id": "c65d1f5e-5f88-4381-958b-fbbcbb1c00f0",
			"migrations_dir": "../../db/migrations"
		}
	]
}
